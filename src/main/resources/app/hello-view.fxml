<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.HelloController"
            styleClass="landing-root">

  <!-- ================= TOP BAR ================= -->
  <top>
    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="landing-top-bar">

      <VBox spacing="2">
        <Label text="Research Publications App"
               styleClass="landing-app-title"/>

        <Label text="Bibliographic data analysis system"
               styleClass="landing-app-subtitle"/>
      </VBox>

      <Region HBox.hgrow="ALWAYS"/>

      <Label text="Research Analytics"
             styleClass="landing-top-badge"/>
    </HBox>
  </top>

  <!-- ================= CONTENT ================= -->
  <center>
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                pannable="true"
                styleClass="landing-scroll">

      <content>
        <StackPane alignment="TOP_CENTER" styleClass="landing-background">
          <padding>
            <Insets top="30" right="42" bottom="42" left="42"/>
          </padding>

          <VBox spacing="24"
                alignment="TOP_CENTER"
                maxWidth="1360">

            <!-- ================= HERO ================= -->
            <VBox spacing="8"
                  alignment="CENTER_LEFT"
                  maxWidth="1360"
                  styleClass="landing-hero">

              <Label text="Explore Research Publications"
                     wrapText="true"
                     styleClass="landing-hero-title"/>

              <Label text="Search journals, conferences, authors and publication years. Explore profiles, rankings, trends and visual analytics through a clean and intuitive desktop experience."
                     wrapText="true"
                     maxWidth="980"
                     styleClass="landing-hero-description"/>
            </VBox>

            <!-- ================= SECTION TITLE ================= -->
            <HBox alignment="CENTER_LEFT" maxWidth="1360">
              <VBox spacing="4">
                <Label text="What can you explore?"
                       styleClass="landing-section-title"/>

                <Label text="Choose the section that matches the analysis you want to perform."
                       styleClass="landing-section-subtitle"/>
              </VBox>
            </HBox>

            <!-- ================= CARDS ================= -->
            <GridPane hgap="20"
                      vgap="20"
                      maxWidth="1360"
                      alignment="CENTER">

              <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
              </columnConstraints>

              <!-- Journals / Conferences -->
              <VBox spacing="16"
                    styleClass="landing-card"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0">

                <HBox spacing="14" alignment="CENTER_LEFT">
                  <StackPane styleClass="landing-card-icon">
                    <Label text="📰" styleClass="landing-card-icon-text"/>
                  </StackPane>

                  <VBox spacing="3">
                    <Label text="Journals / Conferences"
                           styleClass="landing-card-title"/>

                    <Label text="Profiles, rankings and yearly activity"
                           styleClass="landing-card-subtitle"/>
                  </VBox>
                </HBox>

                <Label text="Inspect a journal or conference profile, view ranking information, yearly publication trends and optional article reports."
                       wrapText="true"
                       styleClass="landing-card-description"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Open Venues"
                        onAction="#openVenuePage"
                        maxWidth="Infinity"
                        styleClass="landing-card-button"/>
              </VBox>

              <!-- Years -->
              <VBox spacing="16"
                    styleClass="landing-card"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0">

                <HBox spacing="14" alignment="CENTER_LEFT">
                  <StackPane styleClass="landing-card-icon">
                    <Label text="📅" styleClass="landing-card-icon-text"/>
                  </StackPane>

                  <VBox spacing="3">
                    <Label text="Years"
                           styleClass="landing-card-title"/>

                    <Label text="Publication activity by year"
                           styleClass="landing-card-subtitle"/>
                  </VBox>
                </HBox>

                <Label text="Analyze a selected year and see article counts, journals, conferences, total authors and distinct authors."
                       wrapText="true"
                       styleClass="landing-card-description"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Open Years"
                        onAction="#openYearsPage"
                        maxWidth="Infinity"
                        styleClass="landing-card-button"/>
              </VBox>

              <!-- Authors -->
              <VBox spacing="16"
                    styleClass="landing-card"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1">

                <HBox spacing="14" alignment="CENTER_LEFT">
                  <StackPane styleClass="landing-card-icon">
                    <Label text="🖋" styleClass="landing-card-icon-text"/>
                  </StackPane>

                  <VBox spacing="3">
                    <Label text="Authors"
                           styleClass="landing-card-title"/>

                    <Label text="Researcher profiles and productivity"
                           styleClass="landing-card-subtitle"/>
                  </VBox>
                </HBox>

                <Label text="Search authors and inspect publication history, productivity statistics, first and last publication year."
                       wrapText="true"
                       styleClass="landing-card-description"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Open Authors"
                        onAction="#openAuthorPage"
                        maxWidth="Infinity"
                        styleClass="landing-card-button"/>
              </VBox>

              <!-- Visual Analytics -->
              <VBox spacing="16"
                    styleClass="landing-card"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1">

                <HBox spacing="14" alignment="CENTER_LEFT">
                  <StackPane styleClass="landing-card-icon">
                    <Label text="📊" styleClass="landing-card-icon-text"/>
                  </StackPane>

                  <VBox spacing="3">
                    <Label text="Visual Analytics"
                           styleClass="landing-card-title"/>

                    <Label text="Charts, comparisons and insights"
                           styleClass="landing-card-subtitle"/>
                  </VBox>
                </HBox>

                <Label text="Compare publication activity through targeted visualizations and identify trends across venues, authors and years."
                       wrapText="true"
                       styleClass="landing-card-description"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Open Analytics"
                        onAction="#openChartsPage"
                        maxWidth="Infinity"
                        styleClass="landing-card-button"/>
              </VBox>

            </GridPane>
          </VBox>
        </StackPane>
      </content>
    </ScrollPane>
  </center>

</BorderPane>