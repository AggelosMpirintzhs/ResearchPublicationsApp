<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.charts.PublisherAnalysisController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            pannable="true"
            styleClass="page-scroll">

    <content>
        <StackPane alignment="TOP_CENTER">
            <padding>
                <Insets top="24" right="24" bottom="42" left="24"/>
            </padding>

            <VBox spacing="22"
                  alignment="TOP_CENTER"
                  maxWidth="1500">

                <VBox spacing="10"
                      styleClass="venue-hero-card"
                      maxWidth="1500">

                    <Label text="Publisher Analysis"
                           styleClass="venue-hero-title"/>

                    <Label text="Search and compare up to 10 selected publishers through quartile distribution and total publication bar charts."
                           wrapText="true"
                           styleClass="venue-hero-subtitle"/>
                </VBox>

                <VBox spacing="16"
                      styleClass="filter-card"
                      maxWidth="1500">

                    <VBox spacing="5">
                        <Label text="Select publishers"
                               styleClass="content-title"/>

                        <Label text="Search a publisher, add it to the selected list, and then load the analysis. You can compare up to 10 publishers."
                               wrapText="true"
                               styleClass="stat-muted"/>
                    </VBox>

                    <VBox spacing="0"
                          styleClass="google-search-shell">

                        <HBox spacing="10"
                              alignment="CENTER_LEFT"
                              styleClass="google-search-main-row">

                            <Label text="⌕"
                                   styleClass="google-search-icon"/>

                            <TextField fx:id="publisherFilterField"
                                       promptText="Search publisher"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="google-search-input"/>

                            <Button fx:id="addPublisherButton"
                                    text="Add"
                                    onAction="#addSelectedPublisher"
                                    styleClass="google-search-button"/>

                            <Button fx:id="clearPublisherAnalysisButton"
                                    text="Clear"
                                    onAction="#clearPublisherAnalysis"
                                    styleClass="google-secondary-button"/>
                        </HBox>

                        <VBox fx:id="publisherResultsContainer"
                              spacing="6"
                              visible="false"
                              managed="false"
                              styleClass="google-suggestions-panel">

                            <Label text="Suggested publishers"
                                   styleClass="google-suggestions-header"/>

                            <ListView fx:id="publisherResultsListView"
                                      prefHeight="150"
                                      minHeight="150"
                                      maxHeight="150"
                                      styleClass="google-suggestions-list"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Selected publishers"
                               styleClass="venue-results-title"/>

                        <ListView fx:id="selectedPublishersListView"
                                  prefHeight="145"
                                  minHeight="145"
                                  maxHeight="145"
                                  styleClass="venue-results-list"/>
                    </VBox>

                    <HBox spacing="12"
                          alignment="CENTER_LEFT"
                          styleClass="google-search-filters-row">

                        <Button fx:id="loadPublisherAnalysisButton"
                                text="Load Publisher Analysis"
                                onAction="#loadPublisherAnalysis"
                                styleClass="primary-button"/>

                        <Button fx:id="removeSelectedPublisherButton"
                                text="Remove Selected"
                                onAction="#removeSelectedPublisher"
                                styleClass="secondary-button"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="publisherStatusLabel"
                               text="Search for publishers, add up to 10, and load the analysis."
                               styleClass="hint-label"/>
                    </HBox>
                </VBox>

                <VBox spacing="16"
                      styleClass="dashboard-panel charts-dashboard"
                      maxWidth="1500">

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Quartile Distribution"
                                   styleClass="content-title"/>

                            <Label text="Each selected publisher is displayed on the X-axis. The four bar series correspond to Q1, Q2, Q3 and Q4 publication counts."
                                   wrapText="true"
                                   styleClass="stat-muted"/>
                        </VBox>

                        <Label text="BAR CHART"
                               styleClass="small-blue-chip"/>
                    </HBox>

                    <VBox spacing="8"
                          styleClass="chart-card"
                          maxWidth="1500">

                        <Label text="Publication count per publisher and quartile"
                               styleClass="chart-card-title"/>

                        <BarChart fx:id="publisherQuartileBarChart"
                                  prefHeight="560"
                                  minHeight="520"
                                  animated="false"
                                  legendVisible="false"
                                  horizontalGridLinesVisible="true"
                                  verticalGridLinesVisible="false"
                                  alternativeRowFillVisible="false"
                                  alternativeColumnFillVisible="false"
                                  styleClass="beautiful-line-chart">

                            <xAxis>
                                <CategoryAxis fx:id="publisherCategoryAxis"
                                              label="Publisher"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis fx:id="publisherCountAxis"
                                            label="Publications count"
                                            forceZeroInRange="true"
                                            minorTickVisible="false"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox fx:id="publisherLegendBox"
                          spacing="8"
                          styleClass="chart-card"
                          visible="false"
                          managed="false"
                          maxWidth="1500">

                        <Label text="Legend"
                               styleClass="chart-card-title"/>

                        <FlowPane fx:id="publisherLegendFlow"
                                  hgap="10"
                                  vgap="8"
                                  prefWrapLength="1200"/>
                    </VBox>
                </VBox>

                <VBox fx:id="publisherTotalChartBox"
                      spacing="16"
                      styleClass="dashboard-panel charts-dashboard"
                      visible="false"
                      managed="false"
                      maxWidth="1500">

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Total Publications Comparison"
                                   styleClass="content-title"/>

                            <Label text="This chart appears only when at least two publishers are selected."
                                   wrapText="true"
                                   styleClass="stat-muted"/>
                        </VBox>

                        <Label text="BAR CHART"
                               styleClass="small-blue-chip"/>
                    </HBox>

                    <VBox spacing="8"
                          styleClass="chart-card"
                          maxWidth="1500">

                        <Label text="Total publications per publisher"
                               styleClass="chart-card-title"/>

                        <BarChart fx:id="publisherTotalBarChart"
                                  prefHeight="460"
                                  minHeight="420"
                                  animated="false"
                                  legendVisible="false"
                                  horizontalGridLinesVisible="true"
                                  verticalGridLinesVisible="false"
                                  alternativeRowFillVisible="false"
                                  alternativeColumnFillVisible="false"
                                  styleClass="beautiful-line-chart">

                            <xAxis>
                                <CategoryAxis fx:id="publisherTotalCategoryAxis"
                                              label="Publisher"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis fx:id="publisherTotalCountAxis"
                                            label="Total publications"
                                            forceZeroInRange="true"
                                            minorTickVisible="false"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox fx:id="publisherTotalLegendBox"
                          spacing="8"
                          styleClass="chart-card"
                          visible="false"
                          managed="false"
                          maxWidth="1500">

                        <Label text="Legend"
                               styleClass="chart-card-title"/>

                        <FlowPane fx:id="publisherTotalLegendFlow"
                                  hgap="10"
                                  vgap="8"
                                  prefWrapLength="1200"/>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>