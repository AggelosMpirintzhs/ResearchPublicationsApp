<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.charts.PublisherAnalysisController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            pannable="true"
            styleClass="page-scroll">

    <content>
        <StackPane alignment="TOP_CENTER">
            <padding>
                <Insets top="24" right="24" bottom="42" left="24"/>
            </padding>

            <VBox spacing="22"
                  alignment="TOP_CENTER"
                  maxWidth="1500">

                <VBox spacing="10"
                      styleClass="venue-hero-card"
                      maxWidth="1500">

                    <Label text="Publisher Analysis"
                           styleClass="venue-hero-title"/>

                    <Label text="Compare journal publishers and their journal counts per quartile Q1-Q4."
                           wrapText="true"
                           styleClass="venue-hero-subtitle"/>
                </VBox>

                <VBox spacing="16"
                      styleClass="filter-card"
                      maxWidth="1500">

                    <VBox spacing="5">
                        <Label text="Publisher quartile analysis"
                               styleClass="content-title"/>

                        <Label text="Filter publishers or load the top publishers. The bar chart uses Q1-Q4 as separate series."
                               wrapText="true"
                               styleClass="stat-muted"/>
                    </VBox>

                    <HBox spacing="12"
                          alignment="CENTER_LEFT"
                          styleClass="google-search-filters-row">

                        <TextField fx:id="publisherFilterField"
                                   promptText="Optional publisher filter"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="form-control"/>

                        <ComboBox fx:id="publisherLimitComboBox"
                                  promptText="Top N"
                                  prefWidth="140"
                                  styleClass="form-control"/>

                        <Button fx:id="loadPublisherAnalysisButton"
                                text="Load Publisher Analysis"
                                onAction="#loadPublisherAnalysis"
                                styleClass="primary-button"/>

                        <Button fx:id="clearPublisherAnalysisButton"
                                text="Clear"
                                onAction="#clearPublisherAnalysis"
                                styleClass="secondary-button"/>
                    </HBox>

                    <Label fx:id="publisherStatusLabel"
                           text="Choose publisher filter or load top publishers."
                           styleClass="hint-label"/>
                </VBox>

                <VBox spacing="16"
                      styleClass="dashboard-panel charts-dashboard"
                      maxWidth="1500">

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Publishers by Quartile"
                                   styleClass="content-title"/>

                            <Label text="X-axis shows publishers. Y-axis shows journal count. The four series correspond to Q1, Q2, Q3 and Q4."
                                   wrapText="true"
                                   styleClass="stat-muted"/>
                        </VBox>

                        <Label text="PUBLISHER BAR CHART"
                               styleClass="small-blue-chip"/>
                    </HBox>

                    <VBox spacing="8"
                          styleClass="chart-card"
                          maxWidth="1500">

                        <BarChart fx:id="publisherQuartileBarChart"
                                  prefHeight="560"
                                  minHeight="520"
                                  animated="false"
                                  legendVisible="false"
                                  horizontalGridLinesVisible="true"
                                  verticalGridLinesVisible="false"
                                  alternativeRowFillVisible="false"
                                  alternativeColumnFillVisible="false"
                                  styleClass="beautiful-line-chart">

                            <xAxis>
                                <CategoryAxis fx:id="publisherCategoryAxis"
                                              label="Publisher"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis fx:id="publisherCountAxis"
                                            label="Journals count"
                                            forceZeroInRange="true"
                                            minorTickVisible="false"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox fx:id="publisherLegendBox"
                          spacing="8"
                          styleClass="chart-card"
                          visible="false"
                          managed="false"
                          maxWidth="1500">

                        <Label text="Legend"
                               styleClass="chart-card-title"/>

                        <FlowPane fx:id="publisherLegendFlow"
                                  hgap="10"
                                  vgap="8"
                                  prefWrapLength="1200"/>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>