<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.ScatterChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="scatterPageScrollPane"
            fx:controller="controllers.charts.ScatterPlotsController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            pannable="true"
            styleClass="page-scroll">

    <content>
        <StackPane alignment="TOP_CENTER">
            <padding>
                <Insets top="24" right="24" bottom="42" left="24"/>
            </padding>

            <VBox spacing="22"
                  alignment="TOP_CENTER"
                  maxWidth="1500">

                <VBox spacing="10"
                      styleClass="venue-hero-card"
                      maxWidth="1500">

                    <Label text="Scatter Plots"
                           styleClass="venue-hero-title"/>

                    <Label text="Explore correlations between publication metrics and journal ranking metrics."
                           wrapText="true"
                           styleClass="venue-hero-subtitle"/>
                </VBox>

                <VBox spacing="16"
                      styleClass="filter-card"
                      maxWidth="1500">

                    <VBox spacing="5">
                        <Label text="Venue Scatter Plot"
                               styleClass="content-title"/>

                        <Label text="Select journals or conferences. Each point represents one year for one venue."
                               wrapText="true"
                               styleClass="stat-muted"/>
                    </VBox>

                    <VBox spacing="0"
                          styleClass="google-search-shell">

                        <HBox spacing="10"
                              alignment="CENTER_LEFT"
                              styleClass="google-search-main-row">

                            <Label text="⌕"
                                   styleClass="google-search-icon"/>

                            <TextField fx:id="scatterVenueSearchField"
                                       promptText="Search journal or conference"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="google-search-input"/>

                            <ComboBox fx:id="scatterVenueTypeComboBox"
                                      promptText="Type"
                                      prefWidth="180"
                                      styleClass="google-search-combo"/>

                            <Button text="Search"
                                    onAction="#searchVenues"
                                    styleClass="google-secondary-button"/>

                            <Button fx:id="scatterAddSelectedButton"
                                    text="Add"
                                    onAction="#addSelectedVenue"
                                    styleClass="google-search-button"/>
                        </HBox>

                        <VBox fx:id="scatterSearchResultsContainer"
                              spacing="6"
                              visible="false"
                              managed="false"
                              styleClass="google-suggestions-panel">

                            <Label text="Suggested results"
                                   styleClass="google-suggestions-header"/>

                            <ListView fx:id="scatterSearchResultsListView"
                                      prefHeight="145"
                                      minHeight="145"
                                      maxHeight="145"
                                      styleClass="google-suggestions-list"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Selected venues for scatter plot"
                               styleClass="venue-results-title"/>

                        <ListView fx:id="scatterSelectedVenuesListView"
                                  prefHeight="135"
                                  minHeight="135"
                                  maxHeight="135"
                                  styleClass="venue-results-list"/>
                    </VBox>

                    <HBox spacing="12"
                          alignment="CENTER_LEFT"
                          styleClass="google-search-filters-row">

                        <ComboBox fx:id="scatterFromYearComboBox"
                                  promptText="From year"
                                  prefWidth="155"
                                  styleClass="form-control"/>

                        <ComboBox fx:id="scatterToYearComboBox"
                                  promptText="To year"
                                  prefWidth="155"
                                  styleClass="form-control"/>

                        <Button fx:id="scatterLoadVenueButton"
                                text="Load Venue Scatter"
                                onAction="#loadVenueScatter"
                                styleClass="primary-button"/>

                        <Button fx:id="scatterRemoveSelectedButton"
                                text="Remove Selected"
                                onAction="#removeSelectedVenue"
                                styleClass="secondary-button"/>

                        <Button fx:id="scatterClearSelectedButton"
                                text="Clear"
                                onAction="#clearVenueScatter"
                                styleClass="secondary-button"/>
                    </HBox>

                    <Label fx:id="venueScatterStatusLabel"
                           text="Choose journals/conferences and load venue scatter."
                           styleClass="hint-label"/>
                </VBox>

                <VBox spacing="16"
                      styleClass="dashboard-panel charts-dashboard"
                      maxWidth="1500">

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Articles / Year vs Avg Authors / Article"
                                   styleClass="content-title"/>

                            <Label text="X-axis shows articles in a year. Y-axis shows average authors per article for that year."
                                   wrapText="true"
                                   styleClass="stat-muted"/>
                        </VBox>

                        <Label text="VENUE SCATTER"
                               styleClass="small-blue-chip"/>
                    </HBox>

                    <VBox spacing="8"
                          styleClass="chart-card"
                          maxWidth="1500">

                        <ScatterChart fx:id="venueScatterChart"
                                      prefHeight="470"
                                      minHeight="440"
                                      animated="false"
                                      legendVisible="false"
                                      horizontalGridLinesVisible="true"
                                      verticalGridLinesVisible="true"
                                      alternativeRowFillVisible="false"
                                      alternativeColumnFillVisible="false"
                                      styleClass="beautiful-line-chart">

                            <xAxis>
                                <NumberAxis fx:id="scatterArticlesAxis"
                                            label="Articles / year"
                                            forceZeroInRange="true"
                                            minorTickVisible="false"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis fx:id="scatterAuthorsAxis"
                                            label="Avg authors / article"
                                            forceZeroInRange="true"
                                            minorTickVisible="false"/>
                            </yAxis>
                        </ScatterChart>
                    </VBox>

                    <VBox fx:id="venueScatterLegendBox"
                          spacing="8"
                          styleClass="chart-card"
                          visible="false"
                          managed="false"
                          maxWidth="1500">

                        <Label text="Legend"
                               styleClass="chart-card-title"/>

                        <FlowPane fx:id="venueScatterLegendFlow"
                                  hgap="10"
                                  vgap="8"
                                  prefWrapLength="1200"/>
                    </VBox>
                </VBox>

                <VBox spacing="16"
                      styleClass="filter-card"
                      maxWidth="1500">

                    <VBox spacing="5">
                        <Label text="Journal Ranking Scatter Plot"
                               styleClass="content-title"/>

                        <Label text="Choose any two ranking metrics and a Top N limit. Each point represents one journal from the ranking dataset."
                               wrapText="true"
                               styleClass="stat-muted"/>
                    </VBox>

                    <HBox spacing="12"
                          alignment="CENTER_LEFT"
                          styleClass="google-search-filters-row">

                        <ComboBox fx:id="rankingXMetricComboBox"
                                  promptText="X metric"
                                  prefWidth="210"
                                  styleClass="form-control"/>

                        <ComboBox fx:id="rankingYMetricComboBox"
                                  promptText="Y metric"
                                  prefWidth="210"
                                  styleClass="form-control"/>

                        <ComboBox fx:id="rankingLimitComboBox"
                                  promptText="Top N journals"
                                  prefWidth="170"
                                  styleClass="form-control"/>

                        <Button fx:id="loadRankingScatterButton"
                                text="Load Ranking Scatter"
                                onAction="#loadRankingScatter"
                                styleClass="primary-button"/>

                        <Button fx:id="clearRankingScatterButton"
                                text="Clear"
                                onAction="#clearRankingScatter"
                                styleClass="secondary-button"/>
                    </HBox>

                    <Label fx:id="rankingStatusLabel"
                           text="Choose ranking metrics and top N limit, then load journal ranking scatter."
                           styleClass="hint-label"/>
                </VBox>

                <VBox spacing="16"
                      styleClass="dashboard-panel charts-dashboard"
                      maxWidth="1500">

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Journal Ranking Metrics Correlation"
                                   styleClass="content-title"/>

                            <Label text="Each point is a journal from the ranking dataset. Use this chart to inspect correlations between measurable ranking fields."
                                   wrapText="true"
                                   styleClass="stat-muted"/>
                        </VBox>

                        <Label text="RANKING SCATTER"
                               styleClass="small-blue-chip"/>
                    </HBox>

                    <VBox spacing="8"
                          styleClass="chart-card"
                          maxWidth="1500">

                        <ScatterChart fx:id="journalRankingScatterChart"
                                      prefHeight="500"
                                      minHeight="460"
                                      animated="false"
                                      legendVisible="false"
                                      horizontalGridLinesVisible="true"
                                      verticalGridLinesVisible="true"
                                      alternativeRowFillVisible="false"
                                      alternativeColumnFillVisible="false"
                                      styleClass="beautiful-line-chart">

                            <xAxis>
                                <NumberAxis fx:id="rankingXAxis"
                                            label="X metric"
                                            forceZeroInRange="true"
                                            minorTickVisible="false"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis fx:id="rankingYAxis"
                                            label="Y metric"
                                            forceZeroInRange="true"
                                            minorTickVisible="false"/>
                            </yAxis>
                        </ScatterChart>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>