<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.VenueController"
            styleClass="root-pane">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="16" right="26" bottom="16" left="26"/>
            </padding>

            <VBox spacing="2">
                <Label text="Research Publications App"
                       styleClass="app-title"/>

                <Label text="Venue profile dashboard"
                       styleClass="app-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="backButton"
                    text="Back to Home"
                    onAction="#backToHome"
                    styleClass="top-back-button"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="page-scroll">
            <content>
                <StackPane>
                    <padding>
                        <Insets top="28" right="42" bottom="44" left="42"/>
                    </padding>

                    <VBox spacing="22"
                          alignment="TOP_CENTER"
                          maxWidth="1200">

                        <!-- ================= HERO ================= -->
                        <VBox spacing="10"
                              styleClass="venue-hero-card">

                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Journals / Conferences"
                                           styleClass="venue-hero-title"/>

                                    <Label text="Search, select and explore a journal or conference profile with ranking, yearly trends and article details."
                                           styleClass="venue-hero-subtitle"
                                           wrapText="true"/>
                                </VBox>

                                <Label text="PROFILE"
                                       styleClass="hero-chip"/>
                            </HBox>
                        </VBox>

                        <!-- ================= FILTERS ================= -->
                        <VBox spacing="16"
                              styleClass="filter-card"
                              maxWidth="1200">

                            <VBox spacing="5">
                                <Label text="Search Filters"
                                       styleClass="content-title"/>

                                <Label text="Choose Journal or Conference, search by name/acronym, select one result from the list, and optionally restrict results to a year range."
                                       styleClass="stat-muted"
                                       wrapText="true"/>
                            </VBox>

                            <!-- Search row -->
                            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-row">
                                <ComboBox fx:id="venueTypeComboBox"
                                          promptText="Journal / Conference"
                                          prefWidth="205"
                                          styleClass="form-control"/>

                                <TextField fx:id="venueSearchField"
                                           promptText="Search venue"
                                           prefWidth="340"
                                           styleClass="form-control"/>

                                <Button fx:id="searchVenueButton"
                                        text="Search"
                                        onAction="#searchVenues"
                                        styleClass="primary-button"/>

                                <Button fx:id="clearButton"
                                        text="Clear"
                                        onAction="#clear"
                                        styleClass="secondary-button"/>
                            </HBox>

                            <!-- Results panel - hidden before search -->
                            <VBox fx:id="venueResultsContainer"
                                  spacing="10"
                                  visible="false"
                                  managed="false"
                                  styleClass="venue-results-panel">

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                        <Label text="Matching results"
                                               styleClass="venue-results-title"/>

                                        <Label text="Select one journal or conference from the list."
                                               styleClass="venue-results-subtitle"/>
                                    </VBox>

                                    <Label text="SCROLL"
                                           styleClass="small-blue-chip"/>
                                </HBox>

                                <ListView fx:id="venueResultsListView"
                                          prefHeight="178"
                                          minHeight="178"
                                          maxHeight="178"
                                          styleClass="venue-results-list"/>
                            </VBox>

                            <!-- Selected venue row -->
                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="selected-strip">
                                <Label text="Selected"
                                       styleClass="selected-label"/>

                                <Label fx:id="selectedVenueLabel"
                                       text="No venue selected"
                                       styleClass="selected-value"/>
                            </HBox>

                            <!-- Year filters row -->
                            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-row">
                                <ComboBox fx:id="fromYearComboBox"
                                          promptText="From year"
                                          prefWidth="155"
                                          styleClass="form-control"/>

                                <ComboBox fx:id="toYearComboBox"
                                          promptText="To year"
                                          prefWidth="155"
                                          styleClass="form-control"/>

                                <CheckBox fx:id="loadArticlesCheckBox"
                                          text="Load articles"
                                          selected="false"
                                          prefWidth="135"
                                          minHeight="38"
                                          alignment="CENTER_LEFT"
                                          styleClass="load-articles-toggle"/>

                                <Button fx:id="loadProfileButton"
                                        text="Load Profile"
                                        onAction="#loadVenueProfile"
                                        styleClass="primary-button"/>

                                <Label text="To year must be ≥ From year"
                                       styleClass="hint-label"/>
                            </HBox>
                        </VBox>

                        <!-- ================= RANKING + STATISTICS ================= -->
                        <HBox spacing="20"
                              maxWidth="1200">

                            <!-- Ranking -->
                            <VBox spacing="18"
                                  styleClass="ranking-card"
                                  prefWidth="365"
                                  minWidth="345">

                                <Label text="Ranking"
                                       styleClass="ranking-title"/>

                                <VBox spacing="4">
                                    <Label text="Rank / Quartile"
                                           styleClass="ranking-label"/>

                                    <Label fx:id="rankingLabel"
                                           text="-"
                                           styleClass="ranking-value"/>
                                </VBox>

                                <VBox spacing="4">
                                    <Label text="Category"
                                           styleClass="ranking-label"/>

                                    <Label fx:id="categoryLabel"
                                           text="-"
                                           styleClass="ranking-value"/>
                                </VBox>

                                <VBox spacing="4">
                                    <Label text="Ranking metrics"
                                           styleClass="ranking-label"/>

                                    <Label fx:id="rankingMetricsLabel"
                                           text="-"
                                           styleClass="ranking-muted"
                                           wrapText="true"/>
                                </VBox>
                            </VBox>

                            <!-- Statistics -->
                            <VBox spacing="16"
                                  styleClass="stats-panel"
                                  HBox.hgrow="ALWAYS">

                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Profile Statistics"
                                           styleClass="content-title"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="SUMMARY"
                                           styleClass="small-blue-chip"/>
                                </HBox>

                                <GridPane hgap="14" vgap="14">

                                    <VBox spacing="5"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="0"
                                          GridPane.columnIndex="0">
                                        <Label text="First year" styleClass="metric-label"/>
                                        <Label fx:id="firstYearLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="5"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="0"
                                          GridPane.columnIndex="1">
                                        <Label text="Last year" styleClass="metric-label"/>
                                        <Label fx:id="lastYearLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="5"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="0"
                                          GridPane.columnIndex="2">
                                        <Label text="Total articles" styleClass="metric-label"/>
                                        <Label fx:id="totalArticlesLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="5"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="1"
                                          GridPane.columnIndex="0">
                                        <Label text="Author entries" styleClass="metric-label"/>
                                        <Label fx:id="totalAuthorsLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="5"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="1"
                                          GridPane.columnIndex="1">
                                        <Label text="Distinct authors" styleClass="metric-label"/>
                                        <Label fx:id="distinctAuthorsLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="5"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="1"
                                          GridPane.columnIndex="2">
                                        <Label text="Avg authors / article" styleClass="metric-label"/>
                                        <Label fx:id="avgAuthorsArticleLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="5"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="2"
                                          GridPane.columnIndex="0">
                                        <Label text="Avg articles / year" styleClass="metric-label"/>
                                        <Label fx:id="avgArticlesYearLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="5"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="2"
                                          GridPane.columnIndex="1">
                                        <Label text="Avg authors / year" styleClass="metric-label"/>
                                        <Label fx:id="avgAuthorsYearLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                </GridPane>
                            </VBox>

                        </HBox>

                        <!-- ================= YEARLY CHARTS ================= -->
                        <VBox spacing="16"
                              styleClass="dashboard-panel charts-dashboard"
                              maxWidth="1200">

                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Yearly Statistics"
                                           styleClass="content-title"/>

                                    <Label text="Yearly articles, total author entries and distinct authors. Each chart has its own axes and adapts to the selected values."
                                           styleClass="stat-muted"
                                           wrapText="true"/>
                                </VBox>

                                <Label text="LINE CHARTS"
                                       styleClass="small-blue-chip"/>
                            </HBox>

                            <HBox spacing="14"
                                  alignment="TOP_CENTER"
                                  styleClass="charts-row">

                                <!-- Articles chart -->
                                <VBox spacing="8"
                                      styleClass="chart-card"
                                      prefWidth="370"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Published Articles"
                                           styleClass="chart-card-title"/>

                                    <LineChart fx:id="articlesLineChart"
                                               title=""
                                               prefWidth="350"
                                               prefHeight="260"
                                               minHeight="250"
                                               animated="false"
                                               createSymbols="true"
                                               legendVisible="false"
                                               horizontalGridLinesVisible="true"
                                               verticalGridLinesVisible="true"
                                               alternativeRowFillVisible="false"
                                               alternativeColumnFillVisible="false"
                                               styleClass="beautiful-line-chart">
                                        <xAxis>
                                            <NumberAxis fx:id="articlesYearAxis"
                                                        label="Year"
                                                        forceZeroInRange="false"
                                                        minorTickVisible="false"
                                                        tickLabelsVisible="true"
                                                        tickMarkVisible="true"
                                                        tickUnit="1"/>
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="articlesCountAxis"
                                                        label="Articles"
                                                        forceZeroInRange="true"
                                                        minorTickVisible="false"
                                                        tickLabelsVisible="true"
                                                        tickMarkVisible="true"/>
                                        </yAxis>
                                    </LineChart>
                                </VBox>

                                <!-- Author entries chart -->
                                <VBox spacing="8"
                                      styleClass="chart-card"
                                      prefWidth="370"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Total Author Entries"
                                           styleClass="chart-card-title"/>

                                    <LineChart fx:id="authorEntriesLineChart"
                                               title=""
                                               prefWidth="350"
                                               prefHeight="260"
                                               minHeight="250"
                                               animated="false"
                                               createSymbols="true"
                                               legendVisible="false"
                                               horizontalGridLinesVisible="true"
                                               verticalGridLinesVisible="true"
                                               alternativeRowFillVisible="false"
                                               alternativeColumnFillVisible="false"
                                               styleClass="beautiful-line-chart">
                                        <xAxis>
                                            <NumberAxis fx:id="authorEntriesYearAxis"
                                                        label="Year"
                                                        forceZeroInRange="false"
                                                        minorTickVisible="false"
                                                        tickLabelsVisible="true"
                                                        tickMarkVisible="true"
                                                        tickUnit="1"/>
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="authorEntriesCountAxis"
                                                        label="Author entries"
                                                        forceZeroInRange="true"
                                                        minorTickVisible="false"
                                                        tickLabelsVisible="true"
                                                        tickMarkVisible="true"/>
                                        </yAxis>
                                    </LineChart>
                                </VBox>

                                <!-- Distinct authors chart -->
                                <VBox spacing="8"
                                      styleClass="chart-card"
                                      prefWidth="370"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Distinct Authors"
                                           styleClass="chart-card-title"/>

                                    <LineChart fx:id="distinctAuthorsLineChart"
                                               title=""
                                               prefWidth="350"
                                               prefHeight="260"
                                               minHeight="250"
                                               animated="false"
                                               createSymbols="true"
                                               legendVisible="false"
                                               horizontalGridLinesVisible="true"
                                               verticalGridLinesVisible="true"
                                               alternativeRowFillVisible="false"
                                               alternativeColumnFillVisible="false"
                                               styleClass="beautiful-line-chart">
                                        <xAxis>
                                            <NumberAxis fx:id="distinctAuthorsYearAxis"
                                                        label="Year"
                                                        forceZeroInRange="false"
                                                        minorTickVisible="false"
                                                        tickLabelsVisible="true"
                                                        tickMarkVisible="true"
                                                        tickUnit="1"/>
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="distinctAuthorsCountAxis"
                                                        label="Distinct authors"
                                                        forceZeroInRange="true"
                                                        minorTickVisible="false"
                                                        tickLabelsVisible="true"
                                                        tickMarkVisible="true"/>
                                        </yAxis>
                                    </LineChart>
                                </VBox>

                            </HBox>
                        </VBox>

                        <!-- ================= ARTICLE REPORT ================= -->
                        <VBox fx:id="articleReportPanel"
                              spacing="12"
                              styleClass="dashboard-panel article-report-panel"
                              maxWidth="1200"
                              visible="false"
                              managed="false">

                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Article Report"
                                           styleClass="content-title"/>

                                    <Label text="Articles are loaded only when the Load articles option is selected. Results are shown in a fixed-height scrollable table."
                                           styleClass="stat-muted"
                                           wrapText="true"/>
                                </VBox>

                                <Label fx:id="articlesLoadedLabel"
                                       text="Articles Loaded: 0 / 0"
                                       style="-fx-text-fill: #0f4c81; -fx-font-weight: 700; -fx-font-size: 13px;"/>

                                <Label text="SCROLL TABLE"
                                       styleClass="small-blue-chip"/>
                            </HBox>

                            <TableView fx:id="articlesTable"
                                       prefHeight="350"
                                       minHeight="350"
                                       maxHeight="350"
                                       fixedCellSize="34"
                                       styleClass="articles-scroll-table">
                                <columns>
                                    <TableColumn fx:id="yearColumn"
                                                 text="Year"
                                                 prefWidth="80"/>

                                    <TableColumn fx:id="titleColumn"
                                                 text="Title"
                                                 prefWidth="430"/>

                                    <TableColumn fx:id="authorsColumn"
                                                 text="Authors"
                                                 prefWidth="330"/>

                                    <TableColumn fx:id="pagesColumn"
                                                 text="Pages"
                                                 prefWidth="100"/>

                                    <TableColumn fx:id="urlColumn"
                                                 text="URL / EE"
                                                 prefWidth="180"/>
                                </columns>
                            </TableView>
                        </VBox>

                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
