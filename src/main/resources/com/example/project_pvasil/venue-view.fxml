<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.VenueController"
            styleClass="root-pane">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox spacing="16" styleClass="top-bar">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>

            <Label text="Research Publications App"
                   styleClass="app-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="backButton"
                    text="Back to Home"
                    onAction="#backToHome"
                    styleClass="top-back-button"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="page-scroll">
            <content>
                <StackPane>
                    <padding>
                        <Insets top="28" right="42" bottom="42" left="42"/>
                    </padding>

                    <VBox spacing="22"
                          alignment="TOP_CENTER"
                          maxWidth="1180">

                        <!-- Hero -->
                        <VBox spacing="8"
                              styleClass="venue-hero-card">

                            <Label text="Journals / Conferences"
                                   styleClass="venue-hero-title"/>

                            <Label text="Search for a journal or conference, choose one result, and view its ranking, yearly statistics, author activity, and optionally its article report."
                                   styleClass="venue-hero-subtitle"
                                   wrapText="true"/>
                        </VBox>

                        <!-- Filters -->
                        <VBox spacing="14"
                              styleClass="filter-card"
                              maxWidth="1180">

                            <VBox spacing="4">
                                <Label text="Search Filters"
                                       styleClass="content-title"/>

                                <Label text="Choose Journal or Conference, search by name/acronym, select one result from the bar, and optionally restrict results to a year range. To year must be greater than or equal to From year."
                                       styleClass="stat-muted"
                                       wrapText="true"/>
                            </VBox>

                            <!-- Search row -->
                            <HBox spacing="12">
                                <ComboBox fx:id="venueTypeComboBox"
                                          promptText="Journal / Conference"
                                          prefWidth="200"/>

                                <TextField fx:id="venueSearchField"
                                           promptText="Search venue"
                                           prefWidth="320"/>

                                <Button fx:id="searchVenueButton"
                                        text="Search"
                                        onAction="#searchVenues"
                                        styleClass="secondary-button"/>

                                <Button fx:id="clearButton"
                                        text="Clear"
                                        onAction="#clear"
                                        styleClass="secondary-button"/>
                            </HBox>

                            <!-- Results bar -->
                            <VBox spacing="6">
                                <Label text="Matching results"
                                       styleClass="metric-label"/>

                                <FlowPane fx:id="venueResultsPane"
                                          hgap="8"
                                          vgap="8"
                                          prefWrapLength="1050"
                                          styleClass="results-bar"/>
                            </VBox>

                            <!-- Selected venue row -->
                            <HBox spacing="8">
                                <Label text="Selected:"
                                       styleClass="metric-label"/>

                                <Label fx:id="selectedVenueLabel"
                                       text="No venue selected"
                                       style="-fx-text-fill: #1f2937; -fx-font-weight: 600;"/>
                            </HBox>

                            <!-- Year filters row -->
                            <HBox spacing="12">
                                <ComboBox fx:id="fromYearComboBox"
                                          promptText="From year"
                                          prefWidth="150"/>

                                <ComboBox fx:id="toYearComboBox"
                                          promptText="To year"
                                          prefWidth="150"/>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <CheckBox fx:id="loadArticlesCheckBox"
                                              selected="false"/>

                                    <Label text="Load articles"
                                           style="-fx-text-fill: #1f2937; -fx-font-size: 13px;"/>
                                </HBox>

                                <Button fx:id="loadProfileButton"
                                        text="Load Profile"
                                        onAction="#loadVenueProfile"
                                        styleClass="primary-button"/>

                                <Label text="To year must be ≥ From year"
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                            </HBox>
                        </VBox>

                        <!-- Ranking + Statistics -->
                        <HBox spacing="20"
                              maxWidth="1180">

                            <!-- Ranking -->
                            <VBox spacing="14"
                                  styleClass="ranking-card"
                                  prefWidth="340"
                                  minWidth="320">

                                <Label text="Ranking"
                                       styleClass="ranking-title"/>

                                <VBox spacing="3">
                                    <Label text="Rank / Quartile"
                                           styleClass="ranking-label"/>

                                    <Label fx:id="rankingLabel"
                                           text="-"
                                           styleClass="ranking-value"/>
                                </VBox>

                                <VBox spacing="3">
                                    <Label text="Category"
                                           styleClass="ranking-label"/>

                                    <Label fx:id="categoryLabel"
                                           text="-"
                                           styleClass="ranking-value"/>
                                </VBox>

                                <VBox spacing="3">
                                    <Label text="Ranking metrics"
                                           styleClass="ranking-label"/>

                                    <Label fx:id="rankingMetricsLabel"
                                           text="-"
                                           styleClass="ranking-muted"
                                           wrapText="true"/>
                                </VBox>
                            </VBox>

                            <!-- Statistics -->
                            <VBox spacing="14"
                                  styleClass="stats-panel"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Profile Statistics"
                                       styleClass="content-title"/>

                                <GridPane hgap="14" vgap="14">

                                    <VBox spacing="4"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="0"
                                          GridPane.columnIndex="0">
                                        <Label text="First year" styleClass="metric-label"/>
                                        <Label fx:id="firstYearLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="4"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="0"
                                          GridPane.columnIndex="1">
                                        <Label text="Last year" styleClass="metric-label"/>
                                        <Label fx:id="lastYearLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="4"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="0"
                                          GridPane.columnIndex="2">
                                        <Label text="Total articles" styleClass="metric-label"/>
                                        <Label fx:id="totalArticlesLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="4"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="1"
                                          GridPane.columnIndex="0">
                                        <Label text="Author entries" styleClass="metric-label"/>
                                        <Label fx:id="totalAuthorsLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="4"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="1"
                                          GridPane.columnIndex="1">
                                        <Label text="Distinct authors" styleClass="metric-label"/>
                                        <Label fx:id="distinctAuthorsLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="4"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="1"
                                          GridPane.columnIndex="2">
                                        <Label text="Avg authors / article" styleClass="metric-label"/>
                                        <Label fx:id="avgAuthorsArticleLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="4"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="2"
                                          GridPane.columnIndex="0">
                                        <Label text="Avg articles / year" styleClass="metric-label"/>
                                        <Label fx:id="avgArticlesYearLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                    <VBox spacing="4"
                                          styleClass="metric-card"
                                          GridPane.rowIndex="2"
                                          GridPane.columnIndex="1">
                                        <Label text="Avg authors / year" styleClass="metric-label"/>
                                        <Label fx:id="avgAuthorsYearLabel" text="-" styleClass="metric-value"/>
                                    </VBox>

                                </GridPane>
                            </VBox>

                        </HBox>

                        <!-- Yearly Charts -->
                        <VBox spacing="14"
                              alignment="CENTER"
                              styleClass="dashboard-panel"
                              maxWidth="920">

                            <VBox spacing="4" alignment="CENTER_LEFT">
                                <Label text="Yearly Statistics"
                                       styleClass="content-title"/>

                                <Label text="Separate line charts for articles, total author entries, and distinct authors per year. Each chart automatically adapts its axis range to its own values."
                                       styleClass="stat-muted"
                                       wrapText="true"/>
                            </VBox>

                            <LineChart fx:id="articlesLineChart"
                                       title="Articles per year"
                                       prefWidth="780"
                                       maxWidth="780"
                                       prefHeight="230"
                                       minHeight="220"
                                       animated="false"
                                       createSymbols="false"
                                       legendVisible="false">
                                <xAxis>
                                    <NumberAxis fx:id="articlesYearAxis"
                                                label="Year"
                                                forceZeroInRange="false"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="articlesCountAxis"
                                                label="Articles"
                                                forceZeroInRange="true"/>
                                </yAxis>
                            </LineChart>

                            <LineChart fx:id="authorEntriesLineChart"
                                       title="Author entries per year"
                                       prefWidth="780"
                                       maxWidth="780"
                                       prefHeight="230"
                                       minHeight="220"
                                       animated="false"
                                       createSymbols="false"
                                       legendVisible="false">
                                <xAxis>
                                    <NumberAxis fx:id="authorEntriesYearAxis"
                                                label="Year"
                                                forceZeroInRange="false"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="authorEntriesCountAxis"
                                                label="Author entries"
                                                forceZeroInRange="true"/>
                                </yAxis>
                            </LineChart>

                            <LineChart fx:id="distinctAuthorsLineChart"
                                       title="Distinct authors per year"
                                       prefWidth="780"
                                       maxWidth="780"
                                       prefHeight="230"
                                       minHeight="220"
                                       animated="false"
                                       createSymbols="false"
                                       legendVisible="false">
                                <xAxis>
                                    <NumberAxis fx:id="distinctAuthorsYearAxis"
                                                label="Year"
                                                forceZeroInRange="false"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="distinctAuthorsCountAxis"
                                                label="Distinct authors"
                                                forceZeroInRange="true"/>
                                </yAxis>
                            </LineChart>
                        </VBox>

                        <!-- Article Report -->
                        <VBox fx:id="articleReportPanel"
                              spacing="12"
                              styleClass="dashboard-panel"
                              maxWidth="1180">

                            <VBox spacing="4">
                                <Label text="Article Report"
                                       styleClass="content-title"/>

                                <Label text="Articles are loaded only when the Load articles option is selected. If a year range is selected, only articles within that range will be displayed."
                                       styleClass="stat-muted"
                                       wrapText="true"/>
                            </VBox>

                            <TableView fx:id="articlesTable"
                                       prefHeight="280">
                                <columns>
                                    <TableColumn fx:id="yearColumn"
                                                 text="Year"
                                                 prefWidth="80"/>

                                    <TableColumn fx:id="titleColumn"
                                                 text="Title"
                                                 prefWidth="430"/>

                                    <TableColumn fx:id="authorsColumn"
                                                 text="Authors"
                                                 prefWidth="330"/>

                                    <TableColumn fx:id="pagesColumn"
                                                 text="Pages"
                                                 prefWidth="100"/>

                                    <TableColumn fx:id="urlColumn"
                                                 text="URL / EE"
                                                 prefWidth="180"/>
                                </columns>
                            </TableView>
                        </VBox>

                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>