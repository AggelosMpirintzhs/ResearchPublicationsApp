<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.project_pvasil.controller.MainController">

    <top>
        <VBox spacing="4">
            <padding>
                <Insets top="16" right="24" bottom="14" left="24"/>
            </padding>

            <Label text="Research Publications App"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Bibliographic data profiles, reports and visualizations"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <Tab text="Αναζήτηση Προφίλ">
                <fx:include source="profile-search-view.fxml"/>
            </Tab>

            <Tab text="Στοχευμένα Γραφήματα">
                <fx:include source="charts-view.fxml"/>
            </Tab>

        </TabPane>
    </center>

</BorderPane>