<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.project_pvasil.HelloController"
            styleClass="root-pane">

  <!-- ================= TOP BAR ================= -->
  <top>
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="top-bar">
      <VBox spacing="2">
        <Label text="Research Publications App"
               styleClass="app-title"/>

        <Label text="Bibliographic data analysis system"
               styleClass="app-subtitle"/>
      </VBox>
    </HBox>
  </top>

  <!-- ================= CONTENT ================= -->
  <center>
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                pannable="true"
                styleClass="page-scroll">

      <content>
        <StackPane alignment="TOP_CENTER">
          <padding>
            <Insets top="34" right="44" bottom="44" left="44"/>
          </padding>

          <VBox spacing="26"
                maxWidth="1080"
                alignment="TOP_CENTER">

            <!-- ================= INTRO DESCRIPTION ================= -->
            <VBox spacing="10"
                  maxWidth="1080"
                  alignment="CENTER_LEFT"
                  styleClass="simple-home-hero">

              <Label text="This application provides an interactive environment for exploring integrated bibliographic data from journals, conferences, publication years and authors. Through ready-made reports, profiles and visual analytics, users can discover publication activity, rankings, yearly trends and hidden patterns inside the data."
                     wrapText="true"
                     maxWidth="960"
                     styleClass="home-main-description"/>

            </VBox>

            <!-- ================= SECTION TITLE ================= -->
            <HBox alignment="CENTER_LEFT" maxWidth="1080">
              <VBox spacing="3">
                <Label text="Main sections"
                       styleClass="simple-section-title"/>

                <Label text="Choose a section to start exploring the database."
                       styleClass="simple-section-subtitle"/>
              </VBox>
            </HBox>

            <!-- ================= CARDS ================= -->
            <GridPane hgap="20"
                      vgap="20"
                      maxWidth="1080"
                      alignment="CENTER">

              <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
              </columnConstraints>

              <!-- Journals / Conferences -->
              <VBox spacing="12"
                    styleClass="simple-home-card"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0">

                <Label text="Journals / Conferences"
                       styleClass="simple-card-title"/>

                <Label text="View venue profiles, rankings, yearly statistics, publication counts and visual reports."
                       wrapText="true"
                       styleClass="simple-card-text"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Open Section"
                        onAction="#openVenuePage"
                        styleClass="simple-card-button"/>
              </VBox>

              <!-- Years -->
              <VBox spacing="12"
                    styleClass="simple-home-card"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0">

                <Label text="Years"
                       styleClass="simple-card-title"/>

                <Label text="Analyze each publication year with total articles, journals, conferences and distinct authors."
                       wrapText="true"
                       styleClass="simple-card-text"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Open Section"
                        onAction="#openYearsPage"
                        styleClass="simple-card-button"/>
              </VBox>

              <!-- Authors -->
              <VBox spacing="12"
                    styleClass="simple-home-card"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1">

                <Label text="Authors"
                       styleClass="simple-card-title"/>

                <Label text="Explore author profiles, publication activity, first and last publication year and productivity statistics."
                       wrapText="true"
                       styleClass="simple-card-text"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Open Section"
                        onAction="#openAuthorPage"
                        styleClass="simple-card-button"/>
              </VBox>

              <!-- Visual Analytics -->
              <VBox spacing="12"
                    styleClass="simple-home-card"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1">

                <Label text="Visual Analytics"
                       styleClass="simple-card-title"/>

                <Label text="Compare journals and conferences through targeted line charts, yearly trends and publication metrics."
                       wrapText="true"
                       styleClass="simple-card-text"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Open Section"
                        onAction="#openChartsPage"
                        styleClass="simple-card-button"/>
              </VBox>

            </GridPane>
          </VBox>
        </StackPane>
      </content>
    </ScrollPane>
  </center>

</BorderPane>