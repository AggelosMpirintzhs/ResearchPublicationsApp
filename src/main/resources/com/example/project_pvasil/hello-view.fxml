<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.project_pvasil.HelloController"
            styleClass="root-pane">

  <top>
    <HBox styleClass="top-bar">
      <Label text="Research Publications App"
             styleClass="app-title"/>
    </HBox>
  </top>

  <center>
    <StackPane>
      <padding>
        <Insets top="32" right="48" bottom="48" left="48"/>
      </padding>

      <VBox spacing="28"
            alignment="TOP_CENTER"
            maxWidth="1120">

        <!-- Hero section -->
        <VBox spacing="12"
              alignment="CENTER"
              styleClass="hero-box"
              maxWidth="1120">

          <Label text="Welcome to the Research Publications App"
                 styleClass="hero-title"/>

          <Label text="Browse bibliographic data through profiles, reports, yearly statistics, author insights and analytical charts."
                 styleClass="hero-subtitle"
                 wrapText="true"
                 maxWidth="900"/>
        </VBox>

        <Label text="Choose a section to continue"
               styleClass="section-title"/>

        <!-- Navigation cards -->
        <GridPane hgap="28"
                  vgap="28"
                  alignment="CENTER"
                  maxWidth="1000">

          <columnConstraints>
            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
          </columnConstraints>

          <!-- Journals / Conferences -->
          <VBox styleClass="card-box" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Journals / Conferences"
                   styleClass="card-title"/>

            <Label text="View venue profiles, rankings, yearly publication statistics, line charts, and article reports for journals and conferences."
                   styleClass="card-description"/>

            <Button text="Open Section"
                    onAction="#openVenuePage"
                    styleClass="nav-button"/>
          </VBox>

          <!-- Years -->
          <VBox styleClass="card-box" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Years"
                   styleClass="card-title"/>

            <Label text="Explore a selected year, including total publications, distinct journals, distinct conferences, distinct authors, and filtered reports."
                   styleClass="card-description"/>

            <Button text="Coming Soon"
                    disable="true"
                    styleClass="nav-button"/>
          </VBox>

          <!-- Authors -->
          <VBox styleClass="card-box" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Authors"
                   styleClass="card-title"/>

            <Label text="Open author profiles with first and last publication year, total articles, average productivity, and yearly publication charts."
                   styleClass="card-description"/>

            <Button text="Coming Soon"
                    disable="true"
                    styleClass="nav-button"/>
          </VBox>

          <!-- Targeted Charts -->
          <VBox styleClass="card-box" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Targeted Charts"
                   styleClass="card-title"/>

            <Label text="Access line charts, bar charts, and scatter plots for venues, publishers, categories, quartiles, and ranking metrics."
                   styleClass="card-description"/>

            <Button text="Coming Soon"
                    disable="true"
                    styleClass="nav-button"/>
          </VBox>

        </GridPane>

      </VBox>
    </StackPane>
  </center>

</BorderPane>