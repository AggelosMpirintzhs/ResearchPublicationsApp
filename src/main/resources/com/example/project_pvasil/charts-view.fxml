<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ChartsController"
            styleClass="root-pane">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="16" right="26" bottom="16" left="26"/>
            </padding>

            <VBox spacing="2">
                <Label text="Research Publications App"
                       styleClass="app-title"/>

                <Label text="Targeted visual analytics"
                       styleClass="app-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="backButton"
                    text="Back to Home"
                    onAction="#backToHome"
                    styleClass="top-back-button"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll">

            <content>
                <StackPane alignment="TOP_CENTER">
                    <padding>
                        <Insets top="28" right="42" bottom="44" left="42"/>
                    </padding>

                    <VBox spacing="22"
                          alignment="TOP_CENTER"
                          maxWidth="1200">

                        <!-- ================= HERO ================= -->
                        <VBox spacing="10"
                              styleClass="venue-hero-card"
                              maxWidth="1200">

                            <Label text="Targeted Charts"
                                   styleClass="venue-hero-title"/>

                            <Label text="Select journals or conferences and compare their yearly publication activity, author entries or distinct authors through a shared line chart."
                                   wrapText="true"
                                   styleClass="venue-hero-subtitle"/>
                        </VBox>

                        <!-- ================= FILTERS ================= -->
                        <VBox spacing="16"
                              styleClass="filter-card"
                              maxWidth="1200">

                            <VBox spacing="5">
                                <Label text="Chart Filters"
                                       styleClass="content-title"/>

                                <Label text="Search journals or conferences, add one or more venues to the selected list, choose a metric and optionally restrict the chart to a year range."
                                       wrapText="true"
                                       styleClass="stat-muted"/>
                            </VBox>

                            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-row">
                                <ComboBox fx:id="venueTypeComboBox"
                                          promptText="Journal / Conference"
                                          prefWidth="205"
                                          styleClass="form-control"/>

                                <TextField fx:id="venueSearchField"
                                           promptText="Search venue"
                                           prefWidth="340"
                                           styleClass="form-control"/>

                                <Button fx:id="searchButton"
                                        text="Search"
                                        onAction="#searchVenues"
                                        styleClass="primary-button"/>

                                <Button fx:id="addSelectedButton"
                                        text="Add Selected"
                                        onAction="#addSelectedVenue"
                                        styleClass="primary-button"/>

                                <Button fx:id="clearButton"
                                        text="Clear"
                                        onAction="#clear"
                                        styleClass="secondary-button"/>
                            </HBox>

                            <HBox spacing="16"
                                  alignment="TOP_CENTER">

                                <VBox fx:id="searchResultsContainer"
                                      spacing="10"
                                      visible="false"
                                      managed="false"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="venue-results-panel">

                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Matching results"
                                                   styleClass="venue-results-title"/>

                                            <Label text="Select one result and add it to the comparison list."
                                                   styleClass="venue-results-subtitle"/>
                                        </VBox>

                                        <Label text="SCROLL"
                                               styleClass="small-blue-chip"/>
                                    </HBox>

                                    <ListView fx:id="searchResultsListView"
                                              prefHeight="160"
                                              minHeight="160"
                                              maxHeight="160"
                                              styleClass="venue-results-list"/>
                                </VBox>

                                <VBox spacing="8"
                                      HBox.hgrow="ALWAYS">
                                    <Label text="Selected venues"
                                           styleClass="venue-results-title"/>

                                    <ListView fx:id="selectedVenuesListView"
                                              prefHeight="160"
                                              minHeight="160"
                                              maxHeight="160"
                                              styleClass="venue-results-list"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-row">
                                <ComboBox fx:id="metricComboBox"
                                          promptText="Metric"
                                          prefWidth="220"
                                          styleClass="form-control"/>

                                <ComboBox fx:id="fromYearComboBox"
                                          promptText="From year"
                                          prefWidth="155"
                                          styleClass="form-control"/>

                                <ComboBox fx:id="toYearComboBox"
                                          promptText="To year"
                                          prefWidth="155"
                                          styleClass="form-control"/>

                                <Button fx:id="loadChartButton"
                                        text="Load Chart"
                                        onAction="#loadChart"
                                        styleClass="primary-button"/>

                                <Button fx:id="removeSelectedButton"
                                        text="Remove Selected"
                                        onAction="#removeSelectedVenue"
                                        styleClass="secondary-button"/>
                            </HBox>
                        </VBox>

                        <!-- ================= LINE CHART ================= -->
                        <VBox spacing="16"
                              styleClass="dashboard-panel charts-dashboard"
                              maxWidth="1200">

                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Comparative Yearly Line Chart"
                                           styleClass="content-title"/>

                                    <Label text="Each selected journal or conference is displayed as a separate line. The axes adapt automatically to the selected years and values."
                                           wrapText="true"
                                           styleClass="stat-muted"/>
                                </VBox>

                                <Label text="LINE CHART"
                                       styleClass="small-blue-chip"/>
                            </HBox>

                            <VBox spacing="8"
                                  styleClass="chart-card"
                                  maxWidth="1200">

                                <LineChart fx:id="comparisonLineChart"
                                           title=""
                                           prefHeight="430"
                                           minHeight="410"
                                           animated="false"
                                           createSymbols="true"
                                           legendVisible="true"
                                           horizontalGridLinesVisible="true"
                                           verticalGridLinesVisible="true"
                                           alternativeRowFillVisible="false"
                                           alternativeColumnFillVisible="false"
                                           styleClass="beautiful-line-chart">

                                    <xAxis>
                                        <NumberAxis fx:id="yearAxis"
                                                    label="Year"
                                                    forceZeroInRange="false"
                                                    minorTickVisible="false"
                                                    tickLabelsVisible="true"
                                                    tickMarkVisible="true"/>
                                    </xAxis>

                                    <yAxis>
                                        <NumberAxis fx:id="valueAxis"
                                                    label="Value"
                                                    forceZeroInRange="true"
                                                    minorTickVisible="false"
                                                    tickLabelsVisible="true"
                                                    tickMarkVisible="true"/>
                                    </yAxis>
                                </LineChart>
                            </VBox>
                        </VBox>

                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>