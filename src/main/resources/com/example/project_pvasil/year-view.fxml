<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.YearController"
            styleClass="root-pane">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="16" right="26" bottom="16" left="26"/>
            </padding>

            <VBox spacing="2">
                <Label text="Research Publications App"
                       styleClass="app-title"/>

                <Label text="Year profile dashboard"
                       styleClass="app-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="backButton"
                    text="Back to Home"
                    onAction="#backToHome"
                    styleClass="top-back-button"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll">
            <content>
                <StackPane alignment="TOP_CENTER">
                    <padding>
                        <Insets top="28" right="42" bottom="44" left="42"/>
                    </padding>

                    <VBox spacing="22"
                          alignment="TOP_CENTER"
                          maxWidth="1500">

                        <!-- ================= HERO ================= -->
                        <VBox spacing="10"
                              maxWidth="1500"
                              styleClass="venue-hero-card">

                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Years"
                                           styleClass="venue-hero-title"/>

                                    <Label text="Select a year to view publication statistics, distinct journals, distinct conferences, author activity, and optionally the related publication report."
                                           styleClass="venue-hero-subtitle"
                                           wrapText="true"/>
                                </VBox>

                                <Label text="YEAR PROFILE"
                                       styleClass="hero-chip"/>
                            </HBox>
                        </VBox>

                        <!-- ================= FILTERS ================= -->
                        <VBox spacing="16"
                              maxWidth="1500"
                              styleClass="filter-card">

                            <VBox spacing="5">
                                <Label text="Year Filters"
                                       styleClass="content-title"/>

                                <Label text="Choose a year and load its profile. The publication report is optional because it can be heavy for large datasets."
                                       styleClass="stat-muted"
                                       wrapText="true"/>
                            </VBox>

                            <VBox spacing="12"
                                  styleClass="google-search-section"
                                  maxWidth="1500">

                                <VBox spacing="4">
                                    <Label text="Search publication year"
                                           styleClass="google-search-title"/>

                                    <Label text="Select a publication year and optionally load the related publication report."
                                           wrapText="true"
                                           styleClass="google-search-subtitle"/>
                                </VBox>

                                <HBox spacing="10"
                                      alignment="CENTER_LEFT"
                                      styleClass="google-search-bar">

                                    <Label text="⌕"
                                           styleClass="google-search-icon"/>

                                    <ComboBox fx:id="yearComboBox"
                                              promptText="Select year"
                                              prefWidth="165"
                                              styleClass="google-search-combo"/>

                                    <ComboBox fx:id="publicationTypeComboBox"
                                              promptText="Publication type"
                                              prefWidth="180"
                                              styleClass="google-search-combo"/>

                                    <CheckBox fx:id="loadPublicationsCheckBox"
                                              text="Load publications"
                                              selected="false"
                                              prefWidth="175"
                                              minWidth="175"
                                              minHeight="38"
                                              alignment="CENTER_LEFT"
                                              styleClass="google-toggle"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Button fx:id="loadYearButton"
                                            text="Load Profile"
                                            onAction="#loadYearProfile"
                                            styleClass="google-search-button"/>

                                    <Button fx:id="refreshYearsButton"
                                            text="Refresh"
                                            onAction="#loadAvailableYears"
                                            styleClass="google-secondary-button"/>

                                    <Button fx:id="clearButton"
                                            text="Clear"
                                            onAction="#clear"
                                            styleClass="google-secondary-button"/>
                                </HBox>
                            </VBox>

                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="selected-strip">
                                <Label text="Selected"
                                       styleClass="selected-label"/>

                                <Label fx:id="selectedYearLabel"
                                       text="No year selected"
                                       styleClass="selected-value"/>
                            </HBox>
                        </VBox>

                        <!-- ================= YEAR PROFILE STATISTICS ================= -->
                        <VBox spacing="16"
                              maxWidth="1500"
                              styleClass="stats-panel">

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Year Profile Statistics"
                                       styleClass="content-title"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label text="SUMMARY"
                                       styleClass="small-blue-chip"/>
                            </HBox>

                            <GridPane hgap="14" vgap="14">

                                <VBox spacing="5" styleClass="metric-card" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                    <Label text="Year" styleClass="metric-label"/>
                                    <Label fx:id="yearLabel" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                    <Label text="Total articles" styleClass="metric-label"/>
                                    <Label fx:id="totalArticlesLabel" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.rowIndex="0" GridPane.columnIndex="2">
                                    <Label text="Journal articles" styleClass="metric-label"/>
                                    <Label fx:id="totalJournalArticlesLabel" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.rowIndex="0" GridPane.columnIndex="3">
                                    <Label text="Conference articles" styleClass="metric-label"/>
                                    <Label fx:id="totalConferenceArticlesLabel" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                    <Label text="Distinct journals" styleClass="metric-label"/>
                                    <Label fx:id="distinctJournalsLabel" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                    <Label text="Distinct conferences" styleClass="metric-label"/>
                                    <Label fx:id="distinctConferencesLabel" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.rowIndex="1" GridPane.columnIndex="2">
                                    <Label text="Author entries" styleClass="metric-label"/>
                                    <Label fx:id="totalAuthorOccurrencesLabel" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.rowIndex="1" GridPane.columnIndex="3">
                                    <Label text="Distinct authors" styleClass="metric-label"/>
                                    <Label fx:id="distinctAuthorsLabel" text="-" styleClass="metric-value"/>
                                </VBox>

                                <VBox spacing="5" styleClass="metric-card" GridPane.rowIndex="2" GridPane.columnIndex="0">
                                    <Label text="Avg authors / article" styleClass="metric-label"/>
                                    <Label fx:id="avgAuthorsPerArticleLabel" text="-" styleClass="metric-value"/>
                                </VBox>

                            </GridPane>
                        </VBox>

                        <!-- ================= PUBLICATION REPORT ================= -->
                        <VBox fx:id="publicationReportPanel"
                              spacing="12"
                              maxWidth="1500"
                              styleClass="dashboard-panel article-report-panel">

                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Publication Report"
                                           styleClass="content-title"/>

                                    <Label text="Publications are loaded only when the Load publications option is selected. Results are shown in a fixed-height scrollable table."
                                           styleClass="stat-muted"
                                           wrapText="true"/>
                                </VBox>

                                <Label fx:id="articlesLoadedLabel"
                                       text="Articles Loaded: 0 / 0"
                                       style="-fx-text-fill: #0f4c81; -fx-font-weight: 700; -fx-font-size: 13px;"/>

                                <Label text="SCROLL TABLE"
                                       styleClass="small-blue-chip"/>
                            </HBox>

                            <TableView fx:id="publicationsTable"
                                       prefHeight="350"
                                       minHeight="350"
                                       maxHeight="350"
                                       maxWidth="1500"
                                       fixedCellSize="34"
                                       styleClass="articles-scroll-table">
                                <columns>
                                    <TableColumn fx:id="publicationYearColumn" text="Year" prefWidth="80"/>
                                    <TableColumn fx:id="publicationTypeColumn" text="Type" prefWidth="100"/>
                                    <TableColumn fx:id="publicationTitleColumn" text="Title" prefWidth="430"/>
                                    <TableColumn fx:id="publicationVenueColumn" text="Venue" prefWidth="260"/>
                                    <TableColumn fx:id="publicationAuthorsColumn" text="Authors" prefWidth="330"/>
                                    <TableColumn fx:id="publicationPagesColumn" text="Pages" prefWidth="100"/>
                                    <TableColumn fx:id="publicationUrlColumn" text="URL / EE" prefWidth="180"/>
                                </columns>
                            </TableView>
                        </VBox>

                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
